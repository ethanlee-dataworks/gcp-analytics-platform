# Copy to .env and set GCP_PROJECT_ID: cp .env.example .env
# Read by `mise run setup`. Auth comes from gcloud ADC, never a key file.

GCP_PROJECT_ID=your-project-id

# The GA4 public sample lives in US, and BigQuery cannot join across locations.
BQ_LOCATION=US

# Region for regional services (Workload Identity, later Cloud Run).
GCP_REGION=us-central1

# Per-query cap (10 GB). Use it in dbcode and `bq --maximum_bytes_billed`.
BQ_MAX_BYTES_BILLED=10000000000
